# ── Medical Records App Environment Variables ──────────────────────────────
# For local development with Vite dev server (defaults to local proxy):
# Leave empty or set to /api
VITE_API_BASE_URL=/api

# For production deployment on Vercel / Netlify calling a remote backend:
# Set to your cloud backend domain, for example:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
